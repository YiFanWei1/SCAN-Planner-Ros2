<?xml version="1.0"?>
<package format="3">
  <name>scan_mppi_controller</name>
  <version>0.1.0</version>
  <description>Standalone 3-D collision-aware MPPI controller for SCAN-Planner.</description>
  <maintainer email="maintainers@example.com">SCAN MPPI maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>bspline_opt</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <test_depend>rclpy</test_depend>
  <depend>scan_planner_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>go2_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>scan_planner</exec_depend>
  <exec_depend>terrain_path_segmenter</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
