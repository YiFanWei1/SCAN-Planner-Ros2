Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: world
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Inflated 3D occupancy
      Queue Size: 2
      Size (m): 0.035
      Style: Boxes
      Topic:
        Value: /grid_map/occupancy_inflate
    - Class: rviz_default_plugins/Path
      Color: 255; 120; 40
      Enabled: true
      Line Style: Lines
      Line Width: 0.025
      Name: Full SCAN B-spline
      Topic:
        Value: /planning/bspline_path
    - Class: rviz_default_plugins/Path
      Color: 0; 235; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.035
      Name: MPPI reference segment
      Topic:
        Value: /planning/mppi/reference_path
    - Class: rviz_default_plugins/Path
      Color: 40; 255; 40
      Enabled: true
      Line Style: Lines
      Line Width: 0.055
      Name: MPPI optimal trajectory
      Topic:
        Value: /planning/mppi/optimal_trajectory
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: MPPI candidates
      Topic:
        Value: /planning/mppi/candidate_trajectories
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Predicted footprints
      Topic:
        Value: /planning/mppi/optimal_footprints
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Velocity vectors
      Topic:
        Value: /planning/mppi/velocity_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MPPI status
      Topic:
        Value: /planning/mppi/status_markers
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Focal Point:
        X: 0
        Y: 0
        Z: 0.4
      Name: Orbit
      Pitch: 0.65
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1500
