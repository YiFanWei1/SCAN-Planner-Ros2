Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /PointCloud21
        - /TF1/Frames1
        - /MarkerArray1/Topic1
        - /Marker2
        - /Marker2/Topic1
        - /Marker3
      Splitter Ratio: 0.5
    Tree Height: 548
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
